{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["es5", "es6", "dom"],
    "noImplicitAny": true,
    "removeComments": true,
    "preserveConstEnums": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "outDir": "dist/",
    "rootDir": "src",
    "moduleResolution": "node",
    "downlevelIteration": true
  },
  "include": ["./src/**/*.ts"]

}
